# ===========================================================================
#  Git ignore file for the whole repository.
#  Only the *.example files are committed - they contain placeholders.
# ===========================================================================

# --- Node / frontend -------------------------------------------------------
node_modules/
.pnp
.pnp.js
frontend/dist/
dist/
build/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Java / Maven ----------------------------------------------------------
target/
backend/target/
*.class
*.jar
*.war
!.mvn/wrapper/maven-wrapper.jar

# --- Environment files (they contain the real secrets) ---------------------
.env
.env.*
!.env.example

# --- Truststores and private keys ------------------------------------------
# The Aiven CA certificate (backend/certs/ca.crt) is PUBLIC and is committed
# on purpose, so the Docker build can verify the Aiven server certificate.
backend/certs/*.p12
backend/certs/*.jks
backend/certs/*.pem
backend/certs/*.key

# --- IDE files -------------------------------------------------------------
.idea/
.vscode/
*.iml
*.ipr
*.iws
.classpath
.project
.settings/
nbproject/

# --- OS files --------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --- Logs and temporary files ----------------------------------------------
*.log
*.tmp
*.bak
