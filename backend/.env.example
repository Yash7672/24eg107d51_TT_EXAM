# ===========================================================================
#  Backend environment variables
#
#  Copy the real values into Render (Dashboard -> Environment) or export them
#  in your terminal before starting the backend locally.
#  NEVER commit a filled in copy of this file - only this example file.
# ===========================================================================

# --- Database (Aiven MySQL) -------------------------------------------------
# Host, port and database name of your Aiven MySQL service.
# The SSL settings are configured with the variables below.
SPRING_DATASOURCE_URL=jdbc:mysql://<aiven-host>:<aiven-port>/<database>?serverTimezone=UTC&allowPublicKeyRetrieval=true

# Database user created in the Aiven dashboard.
SPRING_DATASOURCE_USERNAME=<aiven-username>

# Database password created in the Aiven dashboard.
SPRING_DATASOURCE_PASSWORD=<aiven-password>

# "update" creates missing tables/columns and never deletes data.
# NEVER use "create-drop" or "drop" on a real database.
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# --- SSL for Aiven ----------------------------------------------------------
# VERIFY_IDENTITY encrypts the connection AND validates the certificate of the
# Aiven server. "REQUIRED" would only encrypt the traffic.
SPRING_DATASOURCE_SSL_MODE=VERIFY_IDENTITY

# The truststore with the public Aiven CA certificate.
# In the Docker image the file is already at /app/certs/truststore.p12, so the
# two variables below only have to be set when you run the backend locally.
SPRING_DATASOURCE_TRUSTSTORE_TYPE=PKCS12
SPRING_DATASOURCE_TRUSTSTORE_URL=file:/app/certs/truststore.p12
SPRING_DATASOURCE_TRUSTSTORE_PASSWORD=changeit

# --- CORS -------------------------------------------------------------------
# Comma separated list of frontend origins that may call this API.
# Local: http://localhost:5173
# Production: https://<your-netlify-site>.netlify.app
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Optional ---------------------------------------------------------------
# Port used by the application (Render injects PORT automatically).
PORT=8080
