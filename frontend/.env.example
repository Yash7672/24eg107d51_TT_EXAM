# ===========================================================================
#  Frontend environment variables
#
#  Copy this file to ".env" and fill in the real values:
#      cp .env.example .env      (Windows: copy .env.example .env)
#
#  Vite only exposes variables that start with VITE_ to the browser code.
#  NEVER put database credentials here - everything in the browser is public.
# ===========================================================================

# Base URL of the Spring Boot backend (no trailing slash).
#
# Local development (backend running on your machine):
VITE_API_BASE_URL=http://localhost:8080

# Production - fill this in AFTER the backend is deployed to Render:
# VITE_API_BASE_URL=https://<your-backend-service-name>.onrender.com
