# ===========================================================================
#  Frontend environment variables
#
#  Copy this file to ".env" and fill in the real values:
#      cp .env.example .env      (Windows: copy .env.example .env)
#
#  Vite only exposes variables that start with VITE_ to the browser code.
#  NEVER put database credentials here - everything in the browser is public.
# ===========================================================================

# Base URL of the Spring Boot backend (no trailing slash, no /api at the end).
#
# Local development (backend running on your machine):
VITE_API_BASE_URL=http://localhost:8080

# Production - fill this in AFTER the backend is deployed to Render.
# The same value has to be set in Netlify:
#   Site settings -> Environment variables -> VITE_API_BASE_URL
# VITE_API_BASE_URL=https://<your-backend-service-name>.onrender.com
#
# A local .env file is NOT used by Netlify - it only affects "npm run dev"
# and "npm run build" on your own computer.

# ---------------------------------------------------------------------------
#  NOT allowed in this file (and in every VITE_ variable):
#    database host, database name, database user, database password
#  The browser never talks to MySQL - the database status is read from
#  GET /api/health of the backend.
# ---------------------------------------------------------------------------
